# Optional frontend API origins for explicit Vite builds.
# npm run dev/dev:local generates its own isolated configuration.
# npm run build pins the production origin and ignores local env files.
VITE_FANMARK_API_BASE_URL=https://127.0.0.1:8080
VITE_AUTH_API_BASE_URL=https://127.0.0.1:8080
# External sends remain disabled unless explicitly selected by the production builder.
VITE_BROADCAST_SEND_BACKEND=disabled
VITE_BROADCAST_TEST_SEND_BACKEND=disabled
VITE_ADMIN_DATA_RESET_BACKEND=disabled
