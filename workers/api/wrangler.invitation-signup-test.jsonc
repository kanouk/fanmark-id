{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-invitation-signup-local-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "vars": {
    "D1_TOPOLOGY": "split",
    "AUTH_BACKEND": "better-auth",
    "INVITATION_SIGNUP_BACKEND": "d1",
    "AUTH_EMAIL_BACKEND": "resend",
    "RESEND_API_KEY": "local-resend-test-key-0000000000000000",
    "RESEND_FROM_EMAIL": "no-reply@example.invalid",
    "BETTER_AUTH_SECRET": "local-invitation-signup-test-secret-not-for-deployment-0000000000000000000000",
    "BETTER_AUTH_URL": "https://api.example.test",
    "CORS_ALLOWED_ORIGINS": "https://app.example.test"
  },
  "d1_databases": [
    {
      "binding": "FANMARK_DB",
      "database_name": "fanmark-invitation-signup-local-fixture",
      "database_id": "00000000-0000-0000-0000-000000000094"
    },
    {
      "binding": "AUTH_DB",
      "database_name": "fanmark-auth-invitation-signup-local-fixture",
      "database_id": "00000000-0000-0000-0000-000000000095"
    }
  ]
}
