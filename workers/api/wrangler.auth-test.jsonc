{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-auth-d1-local-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "vars": {
    "D1_TOPOLOGY": "split",
    "AUTH_BACKEND": "better-auth",
    "AUTH_USER_STATUS_BACKEND": "d1",
    "EMOJI_MASTER_ADMIN_BACKEND": "d1",
    "BETTER_AUTH_SECRET": "local-auth-test-only-secret-not-for-deployment-000000000000000000",
    "BETTER_AUTH_URL": "https://api.example.test",
    "CORS_ALLOWED_ORIGINS": "https://app.example.test"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "fanmark-auth-local-fixture",
      "database_id": "00000000-0000-0000-0000-000000000053",
      "migrations_dir": "migrations"
    },
    {
      "binding": "MASTER_DB",
      "database_name": "fanmark-master-local-fixture",
      "database_id": "00000000-0000-0000-0000-000000000065"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS_BUCKET",
      "bucket_name": "fanmark-auth-test-avatars"
    },
    {
      "binding": "COVER_IMAGES_BUCKET",
      "bucket_name": "fanmark-auth-test-cover-images"
    }
  ]
}
