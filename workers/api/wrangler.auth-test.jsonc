{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-auth-d1-local-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "vars": {
    "AUTH_BACKEND": "better-auth",
    "BETTER_AUTH_SECRET": "local-auth-test-only-secret-not-for-deployment-000000000000000000",
    "BETTER_AUTH_URL": "https://api.example.test",
    "CORS_ALLOWED_ORIGINS": "https://app.example.test"
  },
  "d1_databases": [
    {
      "binding": "FANMARK_DB",
      "database_name": "fanmark-auth-local-fixture",
      "database_id": "00000000-0000-0000-0000-000000000053",
      "migrations_dir": "migrations"
    }
  ]
}
