{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-auth-staging-schema",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "account_id": "bfc2890741f0b3fb236e2d755b6c9adc",
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "fanmark-auth-staging",
