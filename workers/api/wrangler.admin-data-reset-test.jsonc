{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-admin-data-reset-local-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "vars": {
    "D1_TOPOLOGY": "split",
    "AUTH_BACKEND": "better-auth",
    "CORS_ALLOWED_ORIGINS": "https://app.example.test",
    "ADMIN_DATA_RESET_BACKEND": "d1"
  },
  "d1_databases": [
    {
      "binding": "FANMARK_DB",
      "database_name": "fanmark-admin-data-reset-local-fixture",
      "database_id": "00000000-0000-0000-0000-000000000099"
    }
  ]
}
