{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-backup-production",
  "main": "src/production-backup-scheduler.ts",
  "compatibility_date": "2026-09-18",
  "account_id": "bfc2890741f0b3fb236e2d755b6c9adc",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 30000
  },
  "services": [
    {
      "binding": "BACKUP_SERVICE",
      "service": "fanmark-app-production",
      "entrypoint": "ProductionBackupService"
    }
  ],
  "vars": {
    "STAGING_BACKUP_SCHEDULE": "disabled",
    "RECOVERY_DRAIN_SCOPE_DIGEST": "6c6685377bca7b2e24d637b4a43888b77a16e280fdc587ce42623156cd615e9d"
  },
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true
  }
}
