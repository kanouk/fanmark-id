{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-backup-staging",
  "main": "src/staging-backup-scheduler.ts",
  "compatibility_date": "2026-09-18",
  "account_id": "bfc2890741f0b3fb236e2d755b6c9adc",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 30000
  },
  "services": [
    {
      "binding": "BACKUP_SERVICE",
      "service": "fanmark-app-staging",
      "entrypoint": "StagingBackupService"
    }
  ],
  "vars": {
    "STAGING_BACKUP_SCHEDULE": "daily-v1",
    "RECOVERY_DRAIN_SCOPE_DIGEST": "4e924bd92fad88fc1dea4c6aae2d808d3df07f142cc3b7cd9a623427848a2801"
  },
  "triggers": {
    "crons": [
      "5 0 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
