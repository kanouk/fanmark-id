{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-backup-staging",
  "main": "src/staging-backup-scheduler.ts",
  "compatibility_date": "2026-09-18",
  "account_id": "bfc2890741f0b3fb236e2d755b6c9adc",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 30000
  },
  "services": [
    {
      "binding": "BACKUP_SERVICE",
      "service": "fanmark-app-staging",
      "entrypoint": "StagingBackupService"
    }
  ],
  "vars": {
    "STAGING_BACKUP_SCHEDULE": "daily-v1",
    "RECOVERY_DRAIN_SCOPE_DIGEST": "aee5fcdc74c564c7358234aa0b8346e9b1a874d9bf5b215493ccb708e8a86392"
  },
  "triggers": {
    "crons": [
      "5 0 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
