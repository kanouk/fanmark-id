{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-backup-staging",
  "main": "src/staging-backup-scheduler.ts",
  "compatibility_date": "2026-09-18",
  "account_id": "bfc2890741f0b3fb236e2d755b6c9adc",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 30000
  },
  "services": [
    {
      "binding": "BACKUP_SERVICE",
      "service": "fanmark-app-staging",
      "entrypoint": "StagingBackupService"
    }
  ],
  "vars": {
    "STAGING_BACKUP_SCHEDULE": "disabled",
    "RECOVERY_DRAIN_SCOPE_DIGEST": "8b4daf214a4e30a837e43387e18d00885dd0a0a563b213c5b736cd87edb84773"
  },
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true
  }
}
