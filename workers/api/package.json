{
  "name": "fanmark-recent-api-contract",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.config.mjs",
    "test:static-assets": "test -f ../../dist/index.html && vitest run --config vitest.static-assets.config.mjs && node ./test/static-assets-router-smoke.mjs",
    "test:watch": "vitest --config vitest.config.mjs",
    "typecheck": "tsc --noEmit",
    "build:dry-run": "wrangler deploy --dry-run --config wrangler.jsonc",
    "build:static-assets:dry-run": "test -f ../../dist/index.html && wrangler deploy --dry-run --config wrangler.static-assets.jsonc",
    "test:d1": "vitest run --config vitest.d1.config.mjs",
    "test:availability:d1": "vitest run --config vitest.availability-d1.config.mjs",
    "test:public-access:d1": "vitest run --config vitest.public-access-d1.config.mjs",
    "test:emoji-catalog:d1": "vitest run --config vitest.emoji-catalog-d1.config.mjs",
    "test:storage-r2": "node test/storage-r2-import.integration.mjs",
    "test:d1-import": "node --test ../../scripts/migration/test-d1-import.mjs",
    "test:license-expiry": "node test/license-expiry.integration.mjs",
    "test:emoji-master-release": "node --experimental-strip-types test/emoji-master-release.integration.mjs",
    "test:lifecycle-schema": "node --test test/lifecycle-target-schema.integration.mjs test/lifecycle-generation.integration.mjs"
  },
  "devDependencies": {
    "@msw/cloudflare": "0.0.1",
    "@cloudflare/vitest-plugin": "1.1.13",
    "@cloudflare/workers-types": "5.20260920.1",
    "miniflare": "5.20260918.0-alpha",
    "msw": "2.15.0",
    "typescript": "5.8.3",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  }
}
