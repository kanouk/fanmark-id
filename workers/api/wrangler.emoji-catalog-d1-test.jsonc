{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-emoji-catalog-d1-local-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "vars": {
    "D1_TOPOLOGY": "split",
    "EMOJI_CATALOG_BACKEND": "d1",
    "CORS_ALLOWED_ORIGINS": "https://app.example.test"
  },
  "d1_databases": [
    {
      "binding": "MASTER_DB",
      "database_name": "fanmark-emoji-catalog-fixture",
      "database_id": "00000000-0000-0000-0000-000000000036"
    }
  ]
}
