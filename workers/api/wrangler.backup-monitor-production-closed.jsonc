{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-backup-monitor-production",
  "main": "src/production-backup-monitor.ts",
  "compatibility_date": "2026-09-18",
  "account_id": "bfc2890741f0b3fb236e2d755b6c9adc",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 10000
  },
  "services": [
    {
      "binding": "BACKUP_ALERT_SERVICE",
      "service": "fanmark-app-production",
      "entrypoint": "ProductionBackupAlertService"
    }
  ],
  "vars": {
    "STAGING_BACKUP_MONITOR": "disabled",
    "RECOVERY_DRAIN_SCOPE_DIGEST": "d70311e65d8f8205443e9230e4443d485a66c1e99831fe5c189d90fe81c121d3",
    "STAGING_BACKUP_SOURCE_IDS": "{\"auth\":\"d25388d6-fa19-46ba-a128-4fa537210e4b\",\"business\":\"a418f597-ff73-40a9-8847-91e3a6dddcf4\",\"master\":\"ef4cee01-bd28-4fd5-8eb8-6744b4331d07\",\"avatars\":\"fanmark-avatars-production-20261020\",\"covers\":\"fanmark-covers-production-20261020\"}",
    "STAGING_BACKUP_SCHEMA_HASHES": "{\"auth\":\"eebbeef152107a683f293b996139cb4789c500982ccd1f8966dd935b105a7565\",\"business\":\"80fd26ba363a2babf649ddbc18490ecd423c4ebfd6be4f90611887f8ffd1b828\",\"master\":\"41eb20e30329eb6a806c11b76f2dcad3144fbbb6c28ba9a8e9d979827a8d7e88\"}",
    "STAGING_BACKUP_KEY_ID": "production-backup-b7453682-6750-41f1-be11-4ce71ca3fa55"
  },
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "STAGING_BACKUP_BUCKET",
      "bucket_name": "fanmark-backups-production"
    }
  ]
}
