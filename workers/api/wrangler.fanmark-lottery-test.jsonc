{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-lottery-local-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "vars": {
    "D1_TOPOLOGY": "split",
    "AUTH_BACKEND": "better-auth",
    "FANMARK_LOTTERY_BACKEND": "d1",
    "CORS_ALLOWED_ORIGINS": "https://app.example.test"
  },
  "d1_databases": [
    {
      "binding": "FANMARK_DB",
      "database_name": "fanmark-lottery-business-local-fixture",
      "database_id": "00000000-0000-0000-0000-000000000093"
    }
  ]
}
