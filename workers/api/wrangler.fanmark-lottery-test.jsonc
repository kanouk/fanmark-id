{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-lottery-local-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "vars": {
    "D1_TOPOLOGY": "split",
    "AUTH_BACKEND": "better-auth",
    "FANMARK_LOTTERY_BACKEND": "d1",
    "CORS_ALLOWED_ORIGINS": "https://app.example.test",
    "AUTH_USER_STATUS_BACKEND": "d1",
    "BETTER_AUTH_SECRET": "local-lottery-test-only-secret-not-for-deployment-000000000000",
    "BETTER_AUTH_URL": "https://api.example.test"
  },
  "d1_databases": [
    {
      "binding": "FANMARK_DB",
      "database_name": "fanmark-lottery-business-local-fixture",
      "database_id": "00000000-0000-0000-0000-000000000093"
    },
    {
      "binding": "AUTH_DB",
      "database_name": "fanmark-lottery-auth-local-fixture",
      "database_id": "00000000-0000-0000-0000-000000000094"
    }
  ]
}
