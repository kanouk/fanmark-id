{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-production-publication-local-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "vars": {
    "D1_TOPOLOGY": "split",
    "RECOVERY_DRAIN_BACKEND": "durable-object",
    "RECOVERY_DRAIN_SCOPE_DIGEST": "6c6685377bca7b2e24d637b4a43888b77a16e280fdc587ce42623156cd615e9d",
    "NOTIFICATION_PROCESSOR_BACKEND": "d1",
    "NOTIFICATION_WAKE_BACKEND": "durable-object",
    "EMOJI_PUBLICATION_BACKEND": "production-service",
    "CF_VERSION_METADATA": {
      "id": "00000000-0000-4000-8000-000000000012"
    },
    "STAGING_BACKUP_SOURCE_IDS": "{\"auth\":\"dc43ffd7-0ca8-45d6-805c-ae1e6f2b58a6\",\"business\":\"84599147-e2c7-41d8-80ae-33c61b158314\",\"master\":\"5973e9f4-cae3-4a2b-b99d-16c2f0ae76da\",\"avatars\":\"fanmark-avatars-production\",\"covers\":\"fanmark-covers-production\"}"
  },
  "d1_databases": [
    {
      "binding": "FANMARK_DB",
      "database_name": "recovery-writer-local-fixture",
      "database_id": "00000000-0000-0000-0000-000000000099"
    },
    {
      "binding": "MASTER_DB",
      "database_name": "emoji-publication-local-master",
      "database_id": "00000000-0000-0000-0000-000000000098"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RECOVERY_DRAIN",
        "class_name": "RecoveryWriterCoordinator"
      },
      {
        "name": "NOTIFICATION_WAKE",
        "class_name": "NotificationWakeCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "recovery-writer-local-v1",
