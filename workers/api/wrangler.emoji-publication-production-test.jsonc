{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-production-publication-local-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "vars": {
    "D1_TOPOLOGY": "split",
    "RECOVERY_DRAIN_BACKEND": "durable-object",
    "RECOVERY_DRAIN_SCOPE_DIGEST": "d70311e65d8f8205443e9230e4443d485a66c1e99831fe5c189d90fe81c121d3",
    "NOTIFICATION_PROCESSOR_BACKEND": "d1",
    "NOTIFICATION_WAKE_BACKEND": "durable-object",
    "EMOJI_PUBLICATION_BACKEND": "production-service",
    "CF_VERSION_METADATA": {
      "id": "00000000-0000-4000-8000-000000000012"
    },
    "STAGING_BACKUP_SOURCE_IDS": "{\"auth\":\"d25388d6-fa19-46ba-a128-4fa537210e4b\",\"business\":\"a418f597-ff73-40a9-8847-91e3a6dddcf4\",\"master\":\"ef4cee01-bd28-4fd5-8eb8-6744b4331d07\",\"avatars\":\"fanmark-avatars-production-20261020\",\"covers\":\"fanmark-covers-production-20261020\"}"
  },
  "d1_databases": [
    {
      "binding": "FANMARK_DB",
      "database_name": "recovery-writer-local-fixture",
      "database_id": "00000000-0000-0000-0000-000000000099"
    },
    {
      "binding": "MASTER_DB",
      "database_name": "emoji-publication-local-master",
      "database_id": "00000000-0000-0000-0000-000000000098"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RECOVERY_DRAIN",
        "class_name": "RecoveryWriterCoordinator"
      },
      {
        "name": "NOTIFICATION_WAKE",
        "class_name": "NotificationWakeCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "recovery-writer-local-v1",
      "new_sqlite_classes": [
        "RecoveryWriterCoordinator",
        "NotificationWakeCoordinator"
      ]
    },
    {
      "tag": "production-coordinators-v2",
      "new_sqlite_classes": [
        "NotificationWakeCoordinatorProductionV2",
        "RecoveryWriterCoordinatorProductionV2"
      ]
    }
  ]
}
