{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-admin-user-management-local-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "vars": {
    "D1_TOPOLOGY": "split",
    "ADMIN_USER_MANAGEMENT_BACKEND": "d1",
    "AUTH_BACKEND": "better-auth",
    "CORS_ALLOWED_ORIGINS": "https://app.example.test"
  },
  "d1_databases": [
    { "binding": "FANMARK_DB", "database_name": "fanmark-admin-users-business-local", "database_id": "00000000-0000-0000-0000-000000000121" },
    { "binding": "AUTH_DB", "database_name": "fanmark-admin-users-auth-local", "database_id": "00000000-0000-0000-0000-000000000122" }
  ]
}
