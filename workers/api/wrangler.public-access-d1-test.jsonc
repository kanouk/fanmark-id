{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-public-access-d1-local-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "vars": {
    "D1_TOPOLOGY": "split",
    "PUBLIC_ACCESS_BACKEND": "d1",
    "CORS_ALLOWED_ORIGINS": "https://app.example.test"
  },
  "d1_databases": [
    {
      "binding": "FANMARK_DB",
      "database_name": "fanmark-public-access-fixture",
      "database_id": "00000000-0000-0000-0000-000000000034"
    },
    {
      "binding": "MASTER_DB",
      "database_name": "fanmark-public-access-master-fixture",
      "database_id": "00000000-0000-0000-0000-000000000037"
    }
  ]
}
