{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-notification-wake-local-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "vars": {
    "D1_TOPOLOGY": "split",
    "NOTIFICATION_PROCESSOR_BACKEND": "d1",
    "NOTIFICATION_WAKE_BACKEND": "durable-object",
    "CORS_ALLOWED_ORIGINS": "https://app.example.test"
  },
  "d1_databases": [{
    "binding": "FANMARK_DB",
    "database_name": "fanmark-notification-wake-local-fixture",
    "database_id": "00000000-0000-0000-0000-000000000096"
  }],
  "durable_objects": {"bindings": [{"name": "NOTIFICATION_WAKE", "class_name": "NotificationWakeCoordinator"}]},
  "migrations": [{"tag": "notification-wake-v1", "new_sqlite_classes": ["NotificationWakeCoordinator"]}]
}
