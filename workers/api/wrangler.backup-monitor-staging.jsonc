{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-backup-monitor-staging",
  "main": "src/staging-backup-monitor.ts",
  "compatibility_date": "2026-09-18",
  "account_id": "bfc2890741f0b3fb236e2d755b6c9adc",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 10000
  },
  "services": [
