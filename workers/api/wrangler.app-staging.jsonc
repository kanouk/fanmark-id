{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-app-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "account_id": "bfc2890741f0b3fb236e2d755b6c9adc",
  "workers_dev": true,
  "limits": {
    "cpu_ms": 30000
  },
  "assets": {
    "directory": "../../dist-staging",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*"
    ]
  },
  "triggers": {
    "crons": [
      "0 0 * * *",
      "* * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "WAITLIST_SIGNUP_LIMITER",
      "namespace_id": "41092701",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "FANMARK_SEARCH_LIMITER",
      "namespace_id": "41092702",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "FANMARK_ACCESS_ANALYTICS_LIMITER",
      "namespace_id": "41092703",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "FANMARK_DB",
      "database_name": "fanmark-recovery-staging-v2-e434eb11-business",
      "database_id": "c99c9f7e-b234-400e-aa89-8d15a168abcc",
      "migrations_dir": "migrations-business",
      "remote": true
    },
    {
      "binding": "AUTH_DB",
      "database_name": "fanmark-recovery-staging-v2-e434eb11-auth",
      "database_id": "2d1a775e-e584-4ce6-baf2-946efc62ff99",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/{0003_better_auth_core.sql,0007_auth_signup_command.sql,0008_auth_user_suspension.sql,0009_auth_oauth_signup.sql}",
      "remote": true
    },
    {
      "binding": "MASTER_DB",
      "database_name": "fanmark-recovery-staging-v2-e434eb11-master",
      "database_id": "02681378-5528-45a9-8093-76805a4705c9",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/{000[0-6]_*.sql,0007_release_audit_timestamps.sql,0008_emoji_master_change_audits.sql}",
      "remote": true
    }
  ],
  "vars": {
    "D1_TOPOLOGY": "split",
    "LICENSE_EXPIRY_BACKEND": "d1",
    "LICENSE_EXPIRY_CRON": "0 0 * * *",
    "NOTIFICATION_ARCHIVE_BACKEND": "d1",
    "NOTIFICATION_ARCHIVE_CRON": "0 0 * * *",
    "LICENSE_EXPIRY_TARGET_INCARNATION": "fanmark-business-staging-lifecycle-v2-e434eb11",
    "LICENSE_EXPIRY_SCHEMA_EXTENSION_DIGEST": "370662758a78a7f0ab01f2ee005bf082c5858065a2ed850aca373350dcef86a9",
    "LICENSE_EXPIRY_MAX_PAGES": "4",
    "LIFECYCLE_RUN_BACKEND": "d1",
    "EMOJI_CATALOG_BACKEND": "d1",
    "REFERENCE_MASTER_BACKEND": "d1",
    "EMOJI_MASTER_ADMIN_BACKEND": "d1",
    "AUTH_BACKEND": "better-auth",
    "AUTH_EMAIL_BACKEND": "resend",
    "RESEND_FROM_EMAIL": "fanmark.id staging <no-reply@fanmark.id>",
    "INVITATION_SIGNUP_BACKEND": "d1",
    "AUTH_SOCIAL_BACKEND": "better-auth",
    "AUTH_SOCIAL_PROVISIONING_BACKEND": "d1",
    "RECENT_FANMARKS_BACKEND": "d1",
    "AVAILABILITY_BACKEND": "d1",
    "PUBLIC_ACCESS_BACKEND": "d1",
    "PROFILE_BACKEND": "d1",
    "ACCOUNT_DELETION_BACKEND": "d1",
    "ADMIN_DATA_RESET_BACKEND": "d1",
    "OWNED_FANMARKS_BACKEND": "d1",
    "FANMARK_PROFILE_BACKEND": "d1",
    "FANMARK_SETTINGS_BACKEND": "d1",
    "FANMARK_RETURN_BACKEND": "d1",
    "FANMARK_REGISTRATION_BACKEND": "d1",
    "FANMARK_LOTTERY_BACKEND": "d1",
    "FANMARK_TRANSFER_BACKEND": "d1",
    "FANMARK_SEARCH_BACKEND": "d1",
    "FANMARK_DETAILS_BACKEND": "d1",
    "FANMARK_ANALYTICS_BACKEND": "d1",
    "FANMARK_ACCESS_ANALYTICS_BACKEND": "d1",
    "FAVORITES_BACKEND": "d1",
    "NOTIFICATIONS_BACKEND": "d1",
    "NOTIFICATION_MASTER_BACKEND": "d1",
    "NOTIFICATION_PROCESSOR_BACKEND": "d1",
    "INVITATION_ADMIN_BACKEND": "d1",
    "WAITLIST_ADMIN_BACKEND": "d1",
    "BROADCAST_EMAIL_BACKEND": "d1",
    "BROADCAST_WEBHOOK_BACKEND": "d1",
    "WAITLIST_SIGNUP_BACKEND": "d1",
    "REFERENCE_MASTER_ADMIN_BACKEND": "d1",
    "EXTENSION_COUPON_BACKEND": "d1",
    "EXTENSION_COUPON_ADMIN_BACKEND": "d1",
    "ADMIN_USER_MANAGEMENT_BACKEND": "d1",
    "AUTH_USER_STATUS_BACKEND": "d1",
    "EMAIL_TEMPLATE_ADMIN_BACKEND": "d1",
    "AUTH_EMAIL_TEMPLATE_BACKEND": "d1",
    "AVAILABILITY_RULES_ADMIN_BACKEND": "d1",
    "MAINTENANCE_SETTINGS_BACKEND": "d1",
    "CUTOVER_WRITE_FREEZE": "false",
    "LIFECYCLE_SETTINGS_BACKEND": "d1",
    "SYSTEM_SETTINGS_BACKEND": "d1",
    "SUBSCRIPTION_BACKEND": "d1",
    "STRIPE_MODE_POLICY": "test_only",
    "STRIPE_WEBHOOK_BACKEND": "d1",
    "STRIPE_DISPATCH_BACKEND": "d1",
    "STRIPE_PLAN_CHECKOUT_BACKEND": "d1",
    "STRIPE_PLAN_CHANGE_BACKEND": "d1",
    "STRIPE_CUSTOMER_PORTAL_BACKEND": "d1",
    "STRIPE_EXTENSION_CHECKOUT_BACKEND": "d1",
    "VERIFIED_ACCESS_BACKEND": "d1",
    "STORAGE_BACKEND": "r2",
    "STORAGE_LEGACY_ORIGIN": "https://synthetic-source.example.invalid",
    "STORAGE_PUBLIC_BASE_URL": "https://fanmark-app-staging.fanmark-id.workers.dev",
    "BETTER_AUTH_URL": "https://fanmark-app-staging.fanmark-id.workers.dev",
    "SUPABASE_URL": "https://synthetic-project.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_fixture_only",
    "CORS_ALLOWED_ORIGINS": "https://fanmark-app-staging.fanmark-id.workers.dev",
    "STAGING_NO_INDEX": "true",
    "NOTIFICATION_WAKE_BACKEND": "durable-object",
    "RECOVERY_DRAIN_BACKEND": "durable-object",
    "RECOVERY_DRAIN_SCOPE_DIGEST": "8b4daf214a4e30a837e43387e18d00885dd0a0a563b213c5b736cd87edb84773",
    "STAGING_BACKUP_BACKEND": "recovery-set-v1",
    "STAGING_BACKUP_ADMISSION": "writers-verified-v1",
    "STAGING_BACKUP_SOURCE_IDS": "{\"auth\":\"2d1a775e-e584-4ce6-baf2-946efc62ff99\",\"business\":\"c99c9f7e-b234-400e-aa89-8d15a168abcc\",\"master\":\"02681378-5528-45a9-8093-76805a4705c9\",\"avatars\":\"fanmark-avatars-staging-v2-e434eb11\",\"covers\":\"fanmark-covers-staging-v2-e434eb11\"}",
    "STAGING_BACKUP_SCHEMA_HASHES": "{\"auth\":\"3d2d1ccf407c1496b58a8e6861ce4eabb00c4e03ffe16c5ab28d521ac2411b1b\",\"business\":\"598cc8655b7272c60103aa4e8826c76047a927b51dec9d8ea0a3ca8bce19d5e2\",\"master\":\"32a98726c6e3e75d3b561657e20685b82cdfa38530ee7b3221505d44693a5f56\"}",
    "STAGING_BACKUP_KEY_ID": "staging-backup-89ca6819-a159-4db8-aa7d-733315a9a0ef"
  },
  "r2_buckets": [
    {
      "binding": "AVATARS_BUCKET",
      "bucket_name": "fanmark-avatars-staging-v2-e434eb11"
    },
    {
      "binding": "COVER_IMAGES_BUCKET",
      "bucket_name": "fanmark-covers-staging-v2-e434eb11"
    },
    {
      "binding": "STAGING_BACKUP_BUCKET",
      "bucket_name": "fanmark-backups-staging"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NOTIFICATION_WAKE",
        "class_name": "NotificationWakeCoordinatorV2"
      },
      {
        "name": "RECOVERY_DRAIN",
        "class_name": "RecoveryWriterCoordinatorV2"
      }
    ]
  },
  "migrations": [
    {
      "tag": "notification-wake-v1",
      "new_sqlite_classes": [
        "NotificationWakeCoordinator"
      ]
    },
    {
      "tag": "recovery-writer-drain-v1",
      "new_sqlite_classes": [
        "RecoveryWriterCoordinator"
      ]
    },
    {
      "tag": "staging-resource-scope-v2",
      "new_sqlite_classes": [
        "NotificationWakeCoordinatorV2",
        "RecoveryWriterCoordinatorV2"
      ]
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
