{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmark-auth-recovery-local-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "vars": {
    "D1_TOPOLOGY": "split",
    "AUTH_BACKEND": "better-auth",
    "AUTH_USER_STATUS_BACKEND": "d1",
    "BETTER_AUTH_SECRET": "local-auth-recovery-only-secret-not-for-deployment-000000000000",
    "BETTER_AUTH_URL": "https://api.example.test",
    "CORS_ALLOWED_ORIGINS": "https://app.example.test"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "fanmark-auth-recovery-source-local-fixture",
      "database_id": "00000000-0000-0000-0000-000000000140"
    },
    {
      "binding": "RECOVERY_AUTH_DB",
      "database_name": "fanmark-auth-recovery-target-local-fixture",
      "database_id": "00000000-0000-0000-0000-000000000141"
    }
  ]
}
